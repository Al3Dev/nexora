# Placeholder names for NEXORA; verify provider configuration before integration.
# Server only — never prefix secrets with VITE_

# API (apps/api)
# PostgreSQL connection. Leave empty in development to use the embedded PGlite database.
DATABASE_URL=
PGLITE_DATA_DIR=./.data/pglite
# HS256 secret used to verify access tokens (at least 32 characters; e.g. the Supabase JWT secret).
AUTH_JWT_SECRET=
AUTH_JWT_ISSUER=
AUTH_JWT_AUDIENCE=
CORS_ORIGIN=http://localhost:5173
PORT=3000

# Providers (not integrated yet)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
PEY_API_KEY=
PEY_WEBHOOK_SECRET=
XAI_API_KEY=

# Public frontend configuration
VITE_API_BASE_URL=http://localhost:3000
